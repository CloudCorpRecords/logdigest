{
  "bin": {
    "logdigest": "dist/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1",
    "zod": "^3"
  },
  "description": "CI log condenser: reads a build or test log and extracts the failure sections, error lines, and failing test names with their original line numbers, so a 10k-line log becomes the 50 lines that matter.",
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "server.json"
  ],
  "homepage": "https://github.com/CloudCorpRecords/logdigest#readme",
  "license": "MIT",
  "mcpName": "io.github.CloudCorpRecords/logdigest",
  "name": "@reneturcios/logdigest",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CloudCorpRecords/logdigest.git"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "type": "module",
  "version": "0.1.0"
}
